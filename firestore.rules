rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Reject writes that are not a well-formed AppState. Stops a malformed
      // or truncated payload from replacing the document with garbage.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.expenses is list
                   && request.resource.data.goals is list
                   && request.resource.data.investments is list
                   && request.resource.data.incomes is list
                   && request.resource.data.settings is map;

      // Automatic pre-write snapshots.
      match /backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
